# Optional model keys. Deterministic extraction works without them.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Required in production. Generate a unique secret with a password manager.
SESSION_SECRET=replace-with-a-unique-random-secret-at-least-32-characters

# Production sign-in accounts. Use unique email addresses and passwords.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-unique-admin-password
DEMO_EMAIL=controller@example.com
DEMO_PASSWORD=replace-with-a-unique-demo-password

# Optional persistent local directory for queue metadata and uploaded files.
# REBATE_DATA_DIR=./data/runtime
